DOOR_API_KEY=your-api-key
DOOR_DEVICE_ID=your-device-id
DOOR_POLL_INTERVAL_SECONDS=5

MQTT_HOST=192.168.1.20
MQTT_PORT=8888
MQTT_USERNAME=smart_home_bridge
MQTT_PASSWORD=change-me-mqtt-password
MQTT_BASE_TOPIC=smart-home-bridge
MQTT_USE_TLS=false

CHICKEN_DOOR_COMMAND_TOPIC=chicken-door/command
CHICKEN_DOOR_STATUS_TOPIC=chicken-door/status
CHICKEN_DOOR_STATUS_CODE_TOPIC=chicken-door/status_code
CHICKEN_DOOR_FAULT_TOPIC=chicken-door/fault
CHICKEN_DOOR_CONNECTED_TOPIC=chicken-door/connected
CHICKEN_DOOR_BATTERY_TOPIC=chicken-door/battery
CHICKEN_DOOR_LIGHT_LEVEL_TOPIC=chicken-door/light_level
CHICKEN_DOOR_USAGE_TOPIC=usage/door

HTTP_HOST=0.0.0.0
HTTP_PORT=8080
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/smart-home-bridge.log

CAMERA_HOST=192.168.1.42
CAMERA_PORT=80
CAMERA_JPG_ENDPOINT=/jpg
CAMERA_HEALTH_ENDPOINT=/health
CAMERA_TIMEOUT_SECONDS=5
CAMERA_MAX_JPEG_BYTES=2000000
CAMERA_AUTH_TOKEN=change-me-camera-token

CHICKEN_THREAT_ENABLED=true
CHICKEN_THREAT_INFERENCE_URL=http://localhost:8090/v1/chicken-threat/infer
CHICKEN_THREAT_INFERENCE_TIMEOUT_SECONDS=10
CHICKEN_THREAT_POLL_INTERVAL_SECONDS=10
